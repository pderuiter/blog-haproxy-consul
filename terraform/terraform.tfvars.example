proxmox_endpoint  = "https://pve.example.com:8006/"
proxmox_api_token = "terraform@pve!blog=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = false
node_name         = "pve"
vm_datastore_id   = "local-lvm"
bridge            = "vmbr0"
gateway           = "10.0.0.254"
dns_servers       = ["192.0.2.53"]
ssh_public_key    = "ssh-ed25519 AAAAC3Nza... you@example.com"

vms = {
  consul-server-1 = { ip = "10.0.0.11/24", groups = ["consul_servers"] }
  consul-server-2 = { ip = "10.0.0.12/24", groups = ["consul_servers"] }
  consul-server-3 = { ip = "10.0.0.13/24", groups = ["consul_servers"] }
  service-node-1  = { ip = "10.0.0.21/24", groups = ["consul_service_nodes"] }
  haproxy-1       = { ip = "10.0.0.31/24", groups = ["haproxy_lb"] }
}
