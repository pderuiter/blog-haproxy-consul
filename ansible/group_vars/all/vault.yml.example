---
# Copy to vault.yml, fill in fresh values and encrypt:
#   ansible-vault encrypt group_vars/all/vault.yml
#
# Consul tokens are created with these AccessorIDs and SecretIDs (uuidgen),
# so reruns find them again. The bootstrap (management) token is generated by
# "consul acl bootstrap" and stays on the first server in
# /root/consul-acl-bootstrap.json (root only).
vault_consul_agent_token_accessor: "00000000-0000-0000-0000-000000000001"
vault_consul_agent_token_secret: "00000000-0000-0000-0000-000000000002"
vault_consul_dataplaneapi_token_accessor: "00000000-0000-0000-0000-000000000003"
vault_consul_dataplaneapi_token_secret: "00000000-0000-0000-0000-000000000004"

# Data Plane API user on the load balancer: the password for the role's API
# calls and its SHA-512 hash for dataplaneapi.yaml (mkpasswd -m sha-512)
vault_dataplaneapi_password: "change-me"
vault_dataplaneapi_password_hash: "$6$changeme$replace-with-mkpasswd-output"
