---
# Copy to vault.yml, fill in fresh UUIDs (uuidgen) and encrypt:
#   ansible-vault encrypt group_vars/all/vault.yml
#
# The agent and consul-template tokens are created with these AccessorIDs and
# SecretIDs, so reruns find them again. The bootstrap (management) token is
# generated by "consul acl bootstrap" and stays on the first server in
# /root/consul-acl-bootstrap.json (root only).
vault_consul_agent_token_accessor: "00000000-0000-0000-0000-000000000001"
vault_consul_agent_token_secret: "00000000-0000-0000-0000-000000000002"
vault_consul_template_token_accessor: "00000000-0000-0000-0000-000000000003"
vault_consul_template_token_secret: "00000000-0000-0000-0000-000000000004"
